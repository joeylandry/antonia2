# Supabase project settings (Project Settings -> API). The publishable key is safe for the
# browser because every table is protected by row-level security. Never commit the service role key;
# the app does not use it.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Public origin used in password-reset emails, e.g. https://antonia.example.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000
